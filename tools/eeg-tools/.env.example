# Shared variables usually come from repo-root .env:
# REDIS_URL=redis://127.0.0.1:6379/0
# EEG_STREAM_KEY_PREFIX=mcs:eeg:transport
# EEG_DEVICE_NAME_HINT=EEG
# EEG_NOTIFY_CHAR_UUID=6e400003-b5a3-f393-e0a9-e50e24dcca9e
# EEG_SCAN_SECONDS=5
# EEG_RECONNECT_DELAY_SECONDS=5

# Bridge runtime
EEG_HOST_BRIDGE_STREAM_KEY=
EEG_HOST_BRIDGE_SOURCE=windows_host_bridge
EEG_HOST_BRIDGE_PAYLOAD_ENCODING=hex
EEG_HOST_BRIDGE_REDIS_MAXLEN=5000
EEG_HOST_BRIDGE_REDIS_APPROX_MAXLEN=true
EEG_HOST_BRIDGE_PUBLISH_BATCH_SIZE=32
EEG_HOST_BRIDGE_PUBLISH_BATCH_TIMEOUT_MS=20
EEG_HOST_BRIDGE_RECORD_ENABLED=false
EEG_HOST_BRIDGE_RECORD_DIR=tools/eeg-tools/data/records
EEG_HOST_BRIDGE_STATUS_FILE=tools/eeg-tools/tmp/status.json
EEG_HOST_BRIDGE_QUEUE_MAXSIZE=2048
EEG_HOST_BRIDGE_HEALTH_FLUSH_INTERVAL_SECONDS=1
EEG_HOST_BRIDGE_QUEUE_FULL_WARNING_INTERVAL_SECONDS=1
EEG_HOST_BRIDGE_LOG_LEVEL=INFO

# Replay runtime
EEG_REPLAY_STREAM_KEY=
EEG_REPLAY_SOURCE=eeg_replay
EEG_REPLAY_PAYLOAD_ENCODING=hex
EEG_REPLAY_REDIS_MAXLEN=5000
EEG_REPLAY_REDIS_APPROX_MAXLEN=true
EEG_REPLAY_MODE=raw
EEG_REPLAY_FILE=
EEG_REPLAY_RESPECT_TIMING=true
EEG_REPLAY_SPEED=1.0
EEG_REPLAY_LOOP=false
EEG_REPLAY_MAX_RECORDS=0
EEG_REPLAY_SOURCE_FILTER=
EEG_REPLAY_SIM_DURATION_SECONDS=30
EEG_REPLAY_SIM_WAVE_RATE_HZ=500
EEG_REPLAY_SIM_FEATURE_RATE_HZ=1
EEG_REPLAY_SIM_PUBLISH_INTERVAL_MS=20
EEG_REPLAY_SIM_AMPLITUDE=20.0
EEG_REPLAY_SIM_DEVICE_ID=EEG-REPLAY
EEG_REPLAY_LOG_LEVEL=INFO
