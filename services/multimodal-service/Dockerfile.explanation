FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMBA_NUM_THREADS=1
COPY requirements-app.txt requirements-explanation.txt ./
RUN pip install --no-cache-dir -r requirements-explanation.txt
COPY app ./app
CMD ["python", "-m", "app.services.eeg_explanation_worker"]
