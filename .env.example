MCS_ENV=development
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
MINIO_PORT=9000
GATEWAY_PORT=8080
CONSULTATION_APP_PORT=3000
OPERATIONS_CONSOLE_PORT=3001
IDENTITY_SERVICE_PORT=8011
CONSULTATION_SERVICE_PORT=8012
ASSESSMENT_SERVICE_PORT=8013
RISK_SERVICE_PORT=8014
INTERVENTION_SERVICE_PORT=8015
FOLLOWUP_SERVICE_PORT=8016
MULTIMODAL_SERVICE_PORT=8017
AI_SERVICE_PORT=8018
MCS_CONTAINER_MULTIMODAL_PORT=18017
# Default Windows EEG development path:
# - Keep the only business multimodal-service inside Docker
# - Start scripts/start_eeg_tools.ps1 on host
# - Do not add MCS_MULTIMODAL_SERVICE_URL in normal development
MCS_CONTAINER_EEG_ENABLED=true
MCS_CONTAINER_EEG_PROVIDER=redis_stream
MCS_CONTAINER_EEG_AUTO_START_TRANSPORT=true
MCS_CONTAINER_EEG_REQUIRE_TRANSPORT_FOR_READY=true
EEG_STREAM_KEY_PREFIX=mcs:eeg:transport
EEG_STREAM_CONSUMER_GROUP=multimodal-eeg
EEG_DEVICE_NAME_HINT=EEG
EEG_NOTIFY_CHAR_UUID=6e400003-b5a3-f393-e0a9-e50e24dcca9e
EEG_SCAN_SECONDS=5
EEG_RECONNECT_DELAY_SECONDS=5

# Optional CPU SHAP worker (--profile eeg-explanations); requires verified EEG reference assets.
EEG_EXPLANATIONS_ENABLED=false
EEG_EXPLANATION_NSAMPLES=512
EEG_EXPLANATION_TIMEOUT_SECONDS=45
EEG_EXPLANATION_MAX_BACKGROUND=64
